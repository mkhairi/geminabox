#!/usr/bin/env bash
# Build the geminabox Docker image and push it to depot.labs.my.
#
# The build context is `git archive HEAD`, never the working tree. Untracked files, such as keys or .envrc, cannot reach the
# image, and the image matches the commit in its tag.
#
# Tags: <version>-<git sha> and latest. Version comes from
# lib/geminabox/version.rb.
#
# Env:
#   IMAGE     image name (default: depot.labs.my/geminabox)
#   PLATFORM  target platform (default: linux/amd64)
#
# Run `docker login depot.labs.my` once before the first push.
set -euo pipefail

usage() {
  cat <<EOF
Usage: bin/build [--no-push]

  --no-push   Build and tag locally. Do not push.
  -h, --help  Show this help.

The image holds HEAD only. Commit changes before building.

Env: IMAGE (default depot.labs.my/geminabox), PLATFORM (default linux/amd64).
EOF
}

push=1
for arg in "$@"; do
  case "$arg" in
    --no-push) push=0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "bin/build: unknown option: $arg" >&2; usage >&2; exit 2 ;;
  esac
done

cd "$(dirname "$0")/.."

image="${IMAGE:-depot.labs.my/geminabox}"
platform="${PLATFORM:-linux/amd64}"

# The Dockerfile installs Gemfile.lock frozen, so it must be in the commit.
if ! git ls-files --error-unmatch Gemfile.lock >/dev/null 2>&1; then
  echo "bin/build: Gemfile.lock is not committed. Run: bundle install && git add Gemfile.lock && git commit" >&2
  exit 1
fi

# Uncommitted changes are not in the archive. Refuse rather than build an
# image that differs from what the developer sees.
if ! git diff --quiet HEAD --; then
  echo "bin/build: uncommitted changes in tracked files are not built. Commit or stash them first." >&2
  git status --short --untracked-files=no >&2
  exit 1
fi

context="$(mktemp -d)"
trap 'rm -rf "$context"' EXIT
git archive HEAD | tar -x -C "$context"

version="$(ruby -e 'require ARGV[0]; print Geminabox::VERSION' "$context/lib/geminabox/version.rb")"
sha="$(git rev-parse --short HEAD)"
tag="${version}-${sha}"

echo "Building ${image}:${tag} for ${platform}"
docker build \
  --platform "$platform" \
  --label "org.opencontainers.image.revision=$(git rev-parse HEAD)" \
  --label "org.opencontainers.image.version=${version}" \
  -t "${image}:${tag}" \
  -t "${image}:latest" \
  "$context"

if [[ $push -eq 0 ]]; then
  echo "Built ${image}:${tag} and ${image}:latest. Not pushed (--no-push)."
  exit 0
fi

for t in "$tag" latest; do
  if ! docker push "${image}:${t}"; then
    echo "bin/build: push of ${image}:${t} failed. If unauthorized, run: docker login ${image%%/*}" >&2
    exit 1
  fi
done
echo "Pushed ${image}:${tag} and ${image}:latest."
