<div class="version-row rounded-box border border-base-300 bg-base-100 p-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <code class="font-mono text-sm">gem "<%= h(version.name) %>", "~> <%= h(version.number) %>"</code>
      <% unless version.platform =~ /^ruby/i %>
        <span class="badge badge-sm badge-ghost mt-2"><%= h(version.platform) %></span>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="copy-command btn btn-sm btn-ghost" title="Copy Gemfile line" aria-label="Copy Gemfile line"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><rect x="4" y="4" width="11" height="11" rx="2"></rect></svg></button>
      <a class="download btn btn-sm btn-outline btn-primary" href="<%= h(url("/gems/#{version.gemfile_name}.gem")) %>">Download</a>
      <% if @allow_delete %>
        <form class="delete-form" method="post" action="<%= h(url("/gems/#{version.gemfile_name}.gem")) %>" data-gem-name="<%= h(version.name) %>" data-version="<%= h(version.number) %>" data-platform="<%= h(version.platform) %>">
          <input type="hidden" name="_method" value="DELETE" />
          <button class="btn btn-sm btn-error" type="submit">Delete</button>
        </form>
      <% end %>
    </div>
  </div>
</div>
