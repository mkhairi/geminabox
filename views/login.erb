<div class="card bg-base-200/90 shadow-2xl backdrop-blur">
  <div class="card-body space-y-6">
    <header class="text-center space-y-2">
      <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-primary/20 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-7 w-7 stroke-current">
          <path d="M12 3 3 9l9 12 9-12-9-6Z" stroke-width="1.5" stroke-linejoin="round"></path>
          <path d="M12 3 9 9l3 12m0-12 3-6" stroke-width="1.5" stroke-linejoin="round"></path>
        </svg>
      </span>
      <h2 class="card-title flex justify-center text-2xl">Welcome back</h2>
      <p class="text-sm text-base-content/70">Sign in to manage your private gem repository.</p>
    </header>

    <% if @login_error %>
      <div class="alert alert-error shadow-sm">
        <span><%= @login_error %></span>
      </div>
    <% end %>

    <form class="space-y-4" method="post" action="<%= url("/login") %>">
      <%= csrf_tag %>
      <label class="form-control w-full">
        <span class="label-text font-semibold">Username</span>
        <input class="input input-bordered w-full" type="text" name="username" autofocus required />
      </label>
      <label class="form-control w-full">
        <span class="label-text font-semibold">Password</span>
        <input class="input input-bordered w-full" type="password" name="password" required />
      </label>
      <div class="card-actions justify-end mt-4">
        <button class="btn btn-primary w-full" type="submit">Continue</button>
      </div>
    </form>
  </div>
</div>
